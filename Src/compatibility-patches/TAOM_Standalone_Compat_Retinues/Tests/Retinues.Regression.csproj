<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Retinues.Regression</AssemblyName>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <NuGetAudit>false</NuGetAudit>
    <GameRoot Condition="'$(GameRoot)' == ''">A:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TAOM_Standalone_Compat_Retinues.csproj" />
    <Reference Include="TaleWorlds.Core" HintPath="$(GameRoot)/bin/Win64_Shipping_Client/TaleWorlds.Core.dll" Private="false" />
    <Reference Include="TaleWorlds.Library" HintPath="$(GameRoot)/bin/Win64_Shipping_Client/TaleWorlds.Library.dll" Private="false" />
    <Reference Include="TaleWorlds.CampaignSystem" HintPath="$(GameRoot)/bin/Win64_Shipping_Client/TaleWorlds.CampaignSystem.dll" Private="false" />
    <Reference Include="TaleWorlds.MountAndBlade" HintPath="$(GameRoot)/bin/Win64_Shipping_Client/TaleWorlds.MountAndBlade.dll" Private="false" />
    <Reference Include="TaleWorlds.ObjectSystem" HintPath="$(GameRoot)/bin/Win64_Shipping_Client/TaleWorlds.ObjectSystem.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameRoot)/Modules/Bannerlord.Harmony/bin/Win64_Shipping_Client/0Harmony.dll" Private="false" />
    <Reference Include="TAOM" HintPath="$(GameRoot)/Modules/TAOM/bin/Win64_Shipping_Client/TAOM.dll" Private="false" />
    <Reference Include="Retinues" HintPath="$(GameRoot)/Modules/Retinues/bin/Win64_Shipping_Client/Retinues.dll" Private="false" />
  </ItemGroup>
</Project>
