<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>LOTRAOM_FactionBuff</AssemblyName>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <InformationalVersion>1.3.0</InformationalVersion>
    <RootNamespace>LOTRAOM.FactionBuff</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <ModuleName>LOTRAOM_FactionBuff</ModuleName>
    <OutputPath>$(MSBuildProjectDirectory)\build\bin\Win64_Shipping_Client\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <BannerlordGamePath Condition="'$(BannerlordGamePath)' == '' and Exists('A:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord')">A:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordGamePath>
    <BannerlordReferenceDir Condition="'$(BannerlordReferenceDir)' == '' and '$(BannerlordGamePath)' != ''">$(BannerlordGamePath)\bin\Win64_Shipping_Client</BannerlordReferenceDir>
    <ModuleDeployRoot Condition="'$(ModuleDeployRoot)' == '' and '$(BannerlordModPath)' != ''">$(BannerlordModPath)\</ModuleDeployRoot>
    <ModuleDeployRoot Condition="'$(ModuleDeployRoot)' == '' and '$(AutoDeployToBannerlord)' == 'true' and '$(BannerlordGamePath)' != ''">$(BannerlordGamePath)\Modules\$(ModuleName)\</ModuleDeployRoot>
    <ModuleBinDeployPath Condition="'$(ModuleBinDeployPath)' == '' and '$(ModuleDeployRoot)' != ''">$(ModuleDeployRoot)bin\Win64_Shipping_Client\</ModuleBinDeployPath>
    <SubModuleSource>$(MSBuildProjectDirectory)\SubModule.xml</SubModuleSource>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine.GauntletUI">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.Engine.GauntletUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.GauntletUI.Data">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.GauntletUI.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.InputSystem">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ScreenSystem">
      <HintPath>$(BannerlordReferenceDir)\TaleWorlds.ScreenSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── Harmony — only NuGet package needed ──────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ── Copy ModuleData XML to mod output on build ────────────────────────── -->
  <ItemGroup>
    <None Include="ModuleData\FactionBuff_GameTexts.xml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="SubModule.xml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Include="GUI\Prefabs\LOTRAOM_FactionBuff.xml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="DeployToBannerlordModule" AfterTargets="Build" Condition="'$(ModuleDeployRoot)' != ''">
    <MakeDir Directories="$(ModuleBinDeployPath)" />

    <ItemGroup>
      <BuiltFiles Include="$(OutputPath)*" />
      <ModuleDataFiles Include="$(MSBuildProjectDirectory)\ModuleData\**\*" Condition="Exists('$(MSBuildProjectDirectory)\ModuleData')" />
      <GuiFiles Include="$(MSBuildProjectDirectory)\GUI\**\*" Condition="Exists('$(MSBuildProjectDirectory)\GUI')" />
    </ItemGroup>

    <Copy SourceFiles="@(BuiltFiles)" DestinationFolder="$(ModuleBinDeployPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(SubModuleSource)" DestinationFolder="$(ModuleDeployRoot)" SkipUnchangedFiles="true" Condition="Exists('$(SubModuleSource)')" />
    <Copy SourceFiles="@(ModuleDataFiles)"
          DestinationFiles="@(ModuleDataFiles->'$(ModuleDeployRoot)ModuleData\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(ModuleDataFiles)' != ''" />
    <Copy SourceFiles="@(GuiFiles)"
          DestinationFiles="@(GuiFiles->'$(ModuleDeployRoot)GUI\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(GuiFiles)' != ''" />

    <Message Text="[LOTRAOM_FactionBuff] Deployed to $(ModuleDeployRoot)" Importance="high" />
  </Target>

</Project>
