    <OutputType>Exe</OutputType>
    <GameRoot Condition="'$(GameRoot)' == ''">A:/SteamLibrary/steamapps/common/Mount &amp; Blade II Bannerlord</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PlayerSpeedControl.csproj" />
    <Reference Include="$(GameRoot)/bin/Win64_Shipping_Client/TaleWorlds.*.dll" Exclude="$(GameRoot)/bin/Win64_Shipping_Client/TaleWorlds.Native.dll" Private="false" />
    <Reference Include="$(GameRoot)/Modules/TAOM.Dependencies/bin/Win64_Shipping_Client/0Harmony.dll" Private="false" />
    <Reference Include="$(GameRoot)/Modules/TAOM.Dependencies/bin/Win64_Shipping_Client/MCMv5.dll" Private="false" />
  </ItemGroup>
</Project>
