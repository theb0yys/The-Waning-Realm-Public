<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/Win64_Shipping_Client/</OutputPath>
    <GameRoot Condition="'$(GameRoot)' == ''">A:/SteamLibrary/steamapps/common/Mount &amp; Blade II Bannerlord</GameRoot>
    <GameBin>$(GameRoot)/bin/Win64_Shipping_Client</GameBin>
    <DependencyBin>$(GameRoot)/Modules/TAOM.Dependencies/bin/Win64_Shipping_Client</DependencyBin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source/*.cs" />
    <Reference Include="$(GameBin)/TaleWorlds.*.dll" Exclude="$(GameBin)/TaleWorlds.Native.dll" Private="false" />
    <Reference Include="$(DependencyBin)/0Harmony.dll" Private="false" />
    <Reference Include="$(DependencyBin)/MCMv5.dll" Private="false" />
  </ItemGroup>
</Project>
