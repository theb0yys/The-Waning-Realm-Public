<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/Win64_Shipping_Client/</OutputPath>
    <GameBin>A:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord\bin\Win64_Shipping_Client</GameBin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="SubModule.cs" />
    <Compile Include="TestStock.cs" />
    <Compile Include="EquipmentIds.cs" />
    <Reference Include="$(GameBin)/TaleWorlds.Library.dll" Private="false" />
    <Reference Include="$(GameBin)/TaleWorlds.Core.dll" Private="false" />
    <Reference Include="$(GameBin)/TaleWorlds.CampaignSystem.dll" Private="false" />
    <Reference Include="$(GameBin)/TaleWorlds.MountAndBlade.dll" Private="false" />
    <Reference Include="$(GameBin)/TaleWorlds.ObjectSystem.dll" Private="false" />
    <Reference Include="$(GameBin)/TaleWorlds.Localization.dll" Private="false" />
  </ItemGroup>
</Project>
